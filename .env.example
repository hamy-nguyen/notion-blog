# Notion database that backs /blog (32-char id from the database URL)
BLOG_INDEX_ID=

# token_v2 session cookie from notion.so. Full-account credential: never commit.
NOTION_TOKEN=

# Absolute origin used for RSS links. Vercel supplies its own; set this for
# any other host, e.g. https://gracesordinaries.com
SITE_URL=
