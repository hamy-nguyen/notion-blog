# misc
.DS_Store
# WHY: the template only ignored .env.local*, so the committed .env leaked real
# credentials. Ignore every .env variant and allow-list the checked-in example.
.env
.env.*
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.blog_index_data
.blog_index_data_previews

.now
.vercel